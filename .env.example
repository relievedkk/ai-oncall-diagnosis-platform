# AI 智能运维与 OnCall 诊断平台 - 本地开发配置模板
# 复制为 .env 后填写真实值；不要提交 .env。

# 应用
APP_NAME=AI 智能运维与 OnCall 诊断平台
APP_VERSION=1.2.1
DEBUG=false
HOST=0.0.0.0
PORT=9900
EXPOSE_API_DOCS=false

# PostgreSQL（诊断任务、步骤、证据和报告）
POSTGRES_DB=oncall
POSTGRES_USER=oncall
POSTGRES_PASSWORD=oncall
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oncall:oncall@127.0.0.1:5432/oncall
# 本地首次启动自动建表；生产环境建议设为 false，并执行 alembic upgrade head。
DATABASE_AUTO_CREATE=true

# RabbitMQ / Celery（独立诊断任务队列）
RABBITMQ_DEFAULT_USER=oncall
RABBITMQ_DEFAULT_PASS=oncall
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://oncall:oncall@127.0.0.1:5672//
CELERY_DEFAULT_QUEUE=diagnosis.default
CELERY_CRITICAL_QUEUE=diagnosis.critical
CELERY_DEAD_LETTER_QUEUE=diagnosis.dead-letter
CELERY_TASK_MAX_RETRIES=5
DIAGNOSIS_LEASE_SECONDS=90
DIAGNOSIS_HEARTBEAT_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=1.0
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
QUEUE_OBSERVER_INTERVAL_SECONDS=15

# LangGraph 会话和执行检查点持久化。留空时从 DATABASE_URL 自动转换。
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# 阿里云 DashScope（DASHSCOPE_API_KEY 必填）
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
LLM_REQUEST_TIMEOUT=120
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus / RAG
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ATTU_PORT=8001
RAG_TOP_K=3
RAG_MODEL=qwen-max
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP。未配置腾讯云凭证时使用仓库内的本地 CLS 示例服务。
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://127.0.0.1:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://127.0.0.1:8004/mcp
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Prometheus / Alertmanager
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0
SERVICE_CATALOG_PATH=config/service_catalog.json
# 必须使用独立强随机值；Alertmanager 通过 Docker Secret 读取。
ALERTMANAGER_WEBHOOK_TOKEN=replace-with-random-64-character-token
FAULT_INJECTION_ENABLED=false

# API Key 供 Prometheus 和自动化脚本使用；Web 用户通过下方账号登录。
AUTH_ENABLED=true
API_KEY=replace-with-random-64-character-api-key
TRUSTED_HOSTS=localhost,127.0.0.1,host.docker.internal
MAX_REQUEST_BODY_BYTES=12582912
MAX_UPLOAD_BYTES=10485760
MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Web 管理员登录。首次启动会创建该账号，后续不会自动覆盖数据库密码。
WEB_LOGIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-admin-password
# 仅限本机临时演示；生产环境必须保持 false。
ALLOW_WEAK_ADMIN_PASSWORD=false
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=7
# 仅在 HTTPS 部署时设为 true；本机 http://localhost 调试保持 false。
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ALLOWED_INDEX_ROOTS=uploads,aiops-docs
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,X-API-Key,X-CSRF-Token,Accept
